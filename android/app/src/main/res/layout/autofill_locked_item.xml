<?xml version="1.0" encoding="utf-8"?>
<!--
  The ONLY entry shown in the system autofill dropdown.
  RemoteViews-safe views only (LinearLayout / ImageView / TextView) and flat
  colors: no credential data is ever rendered here. Tapping it fires the
  authentication PendingIntent that launches FirewoodAutofillPickerActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#FF18181B">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter"
        android:contentDescription="Firewood" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Firewood Vault"
            android:textColor="#FFFAFAFA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authenticate to pick a credential"
            android:textColor="#FFA1A1AA"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="LOCKED"
        android:textColor="#FFFF5722"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
