// screens/home_screen.dart
// Main vault view with floating bottom navigation, logo-only navbar, analytics, password listing, generator, security info, and settings

import 'dart:math';
import 'package:cryptography/cryptography.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter/services.dart';

import '../database/schemas.dart';
import '../models/item_type.dart';
import '../providers/auth_provider.dart';
import '../services/item_service.dart';
import '../services/vault_service.dart';
import '../services/update_service.dart';
import '../theme/app_theme.dart';
import '../theme/app_3d_button.dart';
import 'credential_view_screen.dart';
import 'item_detail_screen.dart';
import 'p2p_receive_screen.dart';
import 'p2p_share_screen.dart';
import 'settings_screen.dart';
import 'vault_setup_screen.dart';
import 'vault_unlock_screen.dart';
import '../services/analytics_service.dart';
import '../services/mini_ml_advisor.dart';

class HomeScreen extends ConsumerStatefulWidget {
  const HomeScreen({super.key});

  @override
  ConsumerState<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends ConsumerState<HomeScreen>
    with TickerProviderStateMixin {
  final ItemService _itemService = ItemService();
  final TextEditingController _searchController = TextEditingController();

  int _currentTabIndex = 0;
  String _searchQuery = '';
  ItemType? _filterType;
  bool _sortDescending = true;
  bool _isGridView = false;

  late AnimationController _fabController;

  @override
  void initState() {
    super.initState();
    _fabController = AnimationController(
      duration: const Duration(milliseconds: 300),
      vsync: this,
    );
    _fabController.forward();
  }

  @override
  void dispose() {
    _fabController.dispose();
    _searchController.dispose();
    super.dispose();
  }

  Future<void> _lockVault() async {
    HapticFeedback.lightImpact();
    ref.read(authProvider.notifier).state = null;

    if (mounted) {
      Navigator.of(context).pushAndRemoveUntil(
        PageRouteBuilder(
          pageBuilder: (_, __, ___) => const VaultUnlockScreen(),
          transitionsBuilder: (_, animation, __, child) {
            return FadeTransition(opacity: animation, child: child);
          },
          transitionDuration: const Duration(milliseconds: 300),
        ),
        (route) => false,
      );
    }
  }

  Future<void> _addItem(SecretKey key) async {
    HapticFeedback.lightImpact();
    await Navigator.of(context).push(
      PageRouteBuilder(
        pageBuilder: (_, __, ___) => ItemDetailScreen(
          secretKey: key,
          itemService: _itemService,
        ),
        transitionsBuilder: (_, animation, __, child) {
          return SlideTransition(
            position: Tween<Offset>(
              begin: const Offset(0, 1),
              end: Offset.zero,
            ).animate(animation),
            child: child,
          );
        },
        transitionDuration: const Duration(milliseconds: 300),
      ),
    );
    setState(() {}); // Refresh list
  }

  Future<void> _viewItem(SecretKey key, DecryptedItem item) async {
    HapticFeedback.lightImpact();
    await Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => CredentialViewScreen(
          secretKey: key,
          itemService: _itemService,
          item: item,
        ),
      ),
    );
    setState(() {}); // Refresh after view
  }

  Future<void> _deleteItem(SecretKey key, DecryptedItem item) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Row(
          children: [
            Icon(Icons.delete_outline, color: Colors.redAccent),
            SizedBox(width: 8),
            Text('Delete Item?'),
          ],
        ),
        content: Text('Delete "${item.title}"? This action cannot be undone.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(context, true),
            style: FilledButton.styleFrom(backgroundColor: Colors.redAccent),
            child: const Text('Delete'),
          ),
        ],
      ),
    );

    if (confirm != true) return;

    try {
      await _itemService.deleteItem(item.itemId);
      if (mounted) {
        HapticFeedback.mediumImpact();
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('"${item.title}" deleted')),
        );
        setState(() {});
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Failed to delete: $e')),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final key = ref.watch(authProvider);

    return Scaffold(
      backgroundColor: AppColors.backgroundZinc,
      appBar: AppBar(
        backgroundColor: AppColors.surfaceZinc,
        elevation: 0,
        centerTitle: false,
        title: FutureBuilder<Vault?>(
          future: VaultService().getVaultInfo(),
          builder: (context, snapshot) {
            final vaultName = snapshot.data?.name ?? 'Firewood Vault';
            return Row(
              children: [
                Container(
                  padding: const EdgeInsets.all(2),
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    border: Border.all(
                      color: AppColors.orangeAccent.withValues(alpha: 0.4),
                      width: 1.5,
                    ),
                  ),
                  child: ClipOval(
                    child: Image.asset(
                      'assets/FWS.png',
                      width: 32,
                      height: 32,
                      fit: BoxFit.cover,
                    ),
                  ),
                ),
                const SizedBox(width: 10),
                Text(
                  vaultName,
                  style: const TextStyle(
                    color: AppColors.offWhite,
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            );
          },
        ),
        actions: [
          Padding(
            padding: const EdgeInsets.only(right: 12),
            child: App3DButton(
              label: 'Lock',
              icon: Icons.lock_outline,
              variant: App3DButtonVariant.neon,
              height: 36,
              fontSize: 12,
              onPressed: _lockVault,
            ),
          ),
        ],
      ),
      body: key == null
          ? Builder(
              builder: (context) {
                WidgetsBinding.instance.addPostFrameCallback((_) async {
                  if (context.mounted) {
                    final hasVault = await VaultService().hasVault();
                    if (context.mounted) {
                      Navigator.of(context).pushAndRemoveUntil(
                        MaterialPageRoute(
                          builder: (_) => hasVault
                              ? const VaultUnlockScreen()
                              : const VaultSetupScreen(),
                        ),
                        (route) => false,
                      );
                    }
                  }
                });
                return const Center(
                  child: CircularProgressIndicator(color: AppColors.orangeAccent),
                );
              },
            )
          : Stack(
              children: [
                IndexedStack(
                  index: _currentTabIndex,
                  children: [
                    _buildHomeDashboardTab(key),
                    _buildPasswordsListingTab(key),
                    _buildGeneratorTab(),
                    const _P2PSharingTab(),
                    const SettingsScreen(),
                  ],
                ),
                Positioned(
                  left: 16,
                  right: 16,
                  bottom: 16,
                  child: _FloatingBottomNavBar(
                    currentIndex: _currentTabIndex,
                    onTap: (index) {
                      HapticFeedback.selectionClick();
                      setState(() => _currentTabIndex = index);
                    },
                  ),
                ),
              ],
            ),
      floatingActionButton: (key != null && _currentTabIndex <= 1)
          ? Padding(
              padding: const EdgeInsets.only(bottom: 68),
              child: ScaleTransition(
                scale: _fabController,
                child: Container(
                  width: 56,
                  height: 56,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: [
                        Theme.of(context).colorScheme.primary.withValues(alpha: 0.95),
                        HSLColor.fromColor(Theme.of(context).colorScheme.primary)
                            .withLightness((HSLColor.fromColor(Theme.of(context).colorScheme.primary).lightness - 0.15).clamp(0.0, 1.0))
                            .toColor(),
                      ],
                    ),
                    border: Border.all(color: Theme.of(context).colorScheme.primary, width: 1),
                    boxShadow: const [
                      BoxShadow(
                        color: Colors.black54,
                        offset: Offset(0, 4),
                        blurRadius: 10,
                      ),
                    ],
                  ),
                  child: Material(
                    color: Colors.transparent,
                    child: InkWell(
                      customBorder: const CircleBorder(),
                      onTap: () => _addItem(key),
                      child: const Center(
                        child: Icon(Icons.add, color: Colors.white, size: 28),
                      ),
                    ),
                  ),
                ),
              ),
            )
          : null,
    );
  }



  // --- TAB 0: HOME DASHBOARD (Metrics & Summary) ---
  Widget _buildHomeDashboardTab(SecretKey key) {
    return FutureBuilder<List<DecryptedItem>>(
      future: _itemService.getAllItems(key),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }

        final items = snapshot.data ?? [];
        final logins = items.where((i) => i.type == ItemType.login.label).toList();
        final cards = items.where((i) => i.type == ItemType.card.label).length;
        final identities = items.where((i) => i.type == ItemType.identity.label).length;
        final notes = items.where((i) => i.type == ItemType.note.label).length;
        final devSecrets = items.where((i) => i.type == ItemType.developerSecret.label).length;
        final report = VaultAnalyticsService.computeReport(items);
        final miniMlTip = MiniMLSecurityAdvisor.classifyVaultHealth(items);

        return RefreshIndicator(
          onRefresh: () async => setState(() {}),
          child: SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(16, 16, 16, 100),
            physics: const AlwaysScrollableScrollPhysics(),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // ROW 1: OVERVIEW & SECURITY HEALTH
                Row(
                  children: [
                    // Card 1: Total Credentials
                    Expanded(
                      child: Container(
                        padding: const EdgeInsets.all(16),
                        decoration: BoxDecoration(
                          color: AppColors.surfaceZinc,
                          borderRadius: BorderRadius.circular(16),
                          border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                        ),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                Container(
                                  padding: const EdgeInsets.all(8),
                                  decoration: BoxDecoration(
                                    color: activeAccent.withValues(alpha: 0.15),
                                    borderRadius: BorderRadius.circular(10),
                                    border: Border.all(color: activeAccent.withValues(alpha: 0.3)),
                                  ),
                                  child: Icon(Icons.shield_outlined, color: activeAccent, size: 18),
                                ),
                                const Spacer(),
                                Text(
                                  '${report.totalItems}',
                                  style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold, color: AppColors.offWhite),
                                ),
                              ],
                            ),
                            const SizedBox(height: 12),
                            const Text(
                              'TOTAL CREDENTIALS',
                              style: TextStyle(fontSize: 10, fontWeight: FontWeight.bold, letterSpacing: 0.8, color: AppColors.textMuted),
                            ),
                            const SizedBox(height: 2),
                            Text(
                              '${report.totalItems} Active & Protected',
                              style: TextStyle(fontSize: 11, fontWeight: FontWeight.w600, color: activeAccent),
                            ),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(width: 12),

                    // Card 2: Security Health Score
                    Expanded(
                      child: Container(
                        padding: const EdgeInsets.all(16),
                        decoration: BoxDecoration(
                          color: AppColors.surfaceZinc,
                          borderRadius: BorderRadius.circular(16),
                          border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                        ),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                Container(
                                  padding: const EdgeInsets.all(8),
                                  decoration: BoxDecoration(
                                    color: (report.securityScore >= 80 ? const Color(0xFF22C55E) : report.securityScore >= 50 ? const Color(0xFFF59E0B) : const Color(0xFFEF4444)).withValues(alpha: 0.15),
                                    borderRadius: BorderRadius.circular(10),
                                    border: Border.all(
                                      color: (report.securityScore >= 80 ? const Color(0xFF22C55E) : report.securityScore >= 50 ? const Color(0xFFF59E0B) : const Color(0xFFEF4444)).withValues(alpha: 0.3),
                                    ),
                                  ),
                                  child: Icon(
                                    Icons.verified_user_outlined,
                                    color: report.securityScore >= 80 ? const Color(0xFF22C55E) : report.securityScore >= 50 ? const Color(0xFFF59E0B) : const Color(0xFFEF4444),
                                    size: 18,
                                  ),
                                ),
                                const Spacer(),
                                Text(
                                  '${report.securityScore}%',
                                  style: TextStyle(
                                    fontSize: 24,
                                    fontWeight: FontWeight.bold,
                                    color: report.securityScore >= 80 ? const Color(0xFF22C55E) : report.securityScore >= 50 ? const Color(0xFFF59E0B) : const Color(0xFFEF4444),
                                  ),
                                ),
                              ],
                            ),
                            const SizedBox(height: 12),
                            const Text(
                              'SECURITY HEALTH',
                              style: TextStyle(fontSize: 10, fontWeight: FontWeight.bold, letterSpacing: 0.8, color: AppColors.textMuted),
                            ),
                            const SizedBox(height: 2),
                            Text(
                              report.securityScore >= 80 ? 'Optimal Protection' : report.securityScore >= 50 ? 'Attention Recommended' : 'Action Required',
                              style: TextStyle(
                                fontSize: 11,
                                fontWeight: FontWeight.w600,
                                color: report.securityScore >= 80 ? const Color(0xFF22C55E) : report.securityScore >= 50 ? const Color(0xFFF59E0B) : const Color(0xFFEF4444),
                              ),
