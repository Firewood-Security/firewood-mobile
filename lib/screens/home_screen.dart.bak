                const SizedBox(height: 16),

                // ROW 2: UNIFIED VAULT ANALYTICS & HEALTH CARD
                Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: AppColors.surfaceZinc,
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Icon(Icons.analytics_outlined, color: activeAccent, size: 18),
                          const SizedBox(width: 8),
                          const Text(
                            'VAULT HEALTH & SECURITY ANALYTICS',
                            style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.1, color: AppColors.offWhite),
                          ),
                        ],
                      ),
                      const SizedBox(height: 16),

                      // Metrics 4-Column Scannable Grid
                      Row(
                        children: [
                          Expanded(child: _AnalyticsMetricChip(label: 'Strong', value: '${report.strongPasswords}', color: const Color(0xFF22C55E))),
                          Expanded(child: _AnalyticsMetricChip(label: 'Weak', value: '${report.weakPasswords}', color: report.weakPasswords > 0 ? const Color(0xFFEF4444) : AppColors.textMuted)),
                          Expanded(child: _AnalyticsMetricChip(label: 'Reused', value: '${report.reusedPasswords}', color: report.reusedPasswords > 0 ? const Color(0xFFF59E0B) : AppColors.textMuted)),
                          Expanded(child: _AnalyticsMetricChip(label: 'Compromised', value: '${report.breachedPasswords}', color: report.breachedPasswords > 0 ? const Color(0xFFEF4444) : const Color(0xFF22C55E))),
                        ],
                      ),
                      const SizedBox(height: 16),

                      // 2FA Coverage Indicator Row
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Row(
                            mainAxisAlignment: MainAxisAlignment.spaceBetween,
                            children: [
                              const Text('2FA Authentication Coverage', style: TextStyle(fontSize: 11, fontWeight: FontWeight.w600, color: AppColors.textMuted)),
                              Text('${report.totpCoveragePercent.round()}%', style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, color: activeAccent)),
                            ],
                          ),
                          const SizedBox(height: 6),
                          ClipRRect(
                            borderRadius: BorderRadius.circular(4),
                            child: LinearProgressIndicator(
                              value: (report.totpCoveragePercent / 100).clamp(0.0, 1.0),
                              minHeight: 6,
                              backgroundColor: AppColors.cardZinc,
                              color: activeAccent,
                            ),
                          ),
                        ],
                      ),

                      if (report.recommendations.isNotEmpty) ...[
                        const Padding(
                          padding: EdgeInsets.symmetric(vertical: 12),
                          child: Divider(color: AppColors.borderZinc, height: 1),
                        ),
                        Row(
                          children: [
                            Icon(Icons.lightbulb_outline, size: 16, color: activeAccent),
                            const SizedBox(width: 8),
                            Expanded(
                              child: Text(
                                report.recommendations.first,
                                style: const TextStyle(fontSize: 11.5, color: AppColors.offWhite, height: 1.3),
                              ),
                            ),
                          ],
                        ),
                      ],
                    ],
                  ),
                ),
                const SizedBox(height: 20),

                // ROW 3: FIVE CREDENTIAL CATEGORY CARDS
                Row(
                  children: [
                    const Text('CREDENTIAL CATEGORIES', style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2, color: AppColors.textMuted)),
                    const Spacer(),
                    Text('${items.length} Total', style: TextStyle(fontSize: 11, color: activeAccent, fontWeight: FontWeight.w600)),
                  ],
                ),
                const SizedBox(height: 10),
                SingleChildScrollView(
                  scrollDirection: Axis.horizontal,
                  physics: const BouncingScrollPhysics(),
                  child: Row(
                    children: [
                      _CategorySummaryCard(
                        title: 'Passwords',
                        count: logins.length,
                        subtitle: '${logins.where((i) => (i.fields['totp_secret'] ?? '').toString().trim().isNotEmpty).length} 2FA Active',
                        icon: Icons.login_outlined,
                        accentColor: activeAccent,
                        isSelected: _filterType == ItemType.login,
                        onTap: () => setState(() { _filterType = ItemType.login; _currentTabIndex = 1; }),
                      ),
                      _CategorySummaryCard(
                        title: 'Cards',
                        count: cards,
                        subtitle: 'Encrypted CVV',
                        icon: Icons.credit_card_outlined,
                        accentColor: const Color(0xFF3B82F6),
                        isSelected: _filterType == ItemType.card,
                        onTap: () => setState(() { _filterType = ItemType.card; _currentTabIndex = 1; }),
                      ),
                      _CategorySummaryCard(
                        title: 'Identity',
                        count: identities,
                        subtitle: 'ID & Passports',
                        icon: Icons.badge_outlined,
                        accentColor: const Color(0xFF8B5CF6),
                        isSelected: _filterType == ItemType.identity,
                        onTap: () => setState(() { _filterType = ItemType.identity; _currentTabIndex = 1; }),
                      ),
                      _CategorySummaryCard(
                        title: 'Accounts',
                        count: devSecrets,
                        subtitle: 'Keys & Tokens',
                        icon: Icons.key_outlined,
                        accentColor: const Color(0xFF10B981),
                        isSelected: _filterType == ItemType.developerSecret,
                        onTap: () => setState(() { _filterType = ItemType.developerSecret; _currentTabIndex = 1; }),
                      ),
                      _CategorySummaryCard(
                        title: 'Secure Notes',
                        count: notes,
                        subtitle: 'Encrypted Notes',
                        icon: Icons.note_outlined,
                        accentColor: const Color(0xFFF43F5E),
                        isSelected: _filterType == ItemType.note,
                        onTap: () => setState(() { _filterType = ItemType.note; _currentTabIndex = 1; }),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 24),

                // ROW 4: RECENT ACTIVITY LIST
                Row(
                  children: [
                    const Text('RECENT CREDENTIALS', style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2, color: AppColors.textMuted)),
                    const Spacer(),
                    TextButton(
                      onPressed: () => setState(() => _currentTabIndex = 1),
                      child: Text('View All', style: TextStyle(color: activeAccent, fontSize: 12, fontWeight: FontWeight.bold)),
                    ),
                  ],
                ),
                const SizedBox(height: 8),
                if (items.isEmpty)
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(24),
                    decoration: BoxDecoration(
                      color: AppColors.surfaceZinc,
                      borderRadius: BorderRadius.circular(16),
                      border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.4)),
                    ),
                    child: const Column(
                      children: [
                        Icon(Icons.shield_outlined, size: 40, color: AppColors.textMuted),
                        SizedBox(height: 8),
                        Text('Vault is Empty', style: TextStyle(color: AppColors.offWhite, fontWeight: FontWeight.bold)),
                        SizedBox(height: 4),
                        Text('Tap + to add your first password or card', style: TextStyle(fontSize: 12, color: AppColors.textMuted)),
                      ],
                    ),
                  )
                else
                  ...items.take(4).map(
                        (item) => _ItemTile(
                          item: item,
                          onTap: () => _viewItem(key, item),
                          onDelete: () => _deleteItem(key, item),
                          index: 0,
                        ),
                      ),
              ],
            ),
          ),
        );
      },
    );
  }

  // --- TAB 1: PASSWORDS / VAULT LISTING (Search, Filter, Sort & Grid inline) ---
  Widget _buildPasswordsListingTab(SecretKey key) {
    return FutureBuilder<List<DecryptedItem>>(
      future: _itemService.getAllItems(key),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }

        var items = snapshot.data ?? [];

        // Apply inline search
        if (_searchQuery.isNotEmpty) {
          items = items.where((item) {
            final title = item.title.toLowerCase();
            final query = _searchQuery.toLowerCase();
            final fields = item.fields.values.map((v) => v.toString().toLowerCase()).join(' ');
            return title.contains(query) || fields.contains(query);
          }).toList();
        }

        // Apply category filter
        if (_filterType != null) {
          items = items.where((item) => item.type == _filterType!.label).toList();
        }

        // Sort items
        items.sort((a, b) => _sortDescending ? b.updatedAt.compareTo(a.updatedAt) : a.updatedAt.compareTo(b.updatedAt));

        return Column(
          children: [
            // Inline Search Bar & Toolbar
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 12, 16, 8),
              child: Column(
                children: [
                  TextField(
                    controller: _searchController,
                    onChanged: (val) => setState(() => _searchQuery = val),
                    style: const TextStyle(color: AppColors.offWhite, fontSize: 14),
                    decoration: InputDecoration(
                      hintText: 'Search vault items...',
                      prefixIcon: const Icon(Icons.search, color: AppColors.textMuted, size: 20),
                      suffixIcon: _searchQuery.isNotEmpty
                          ? IconButton(
                              icon: const Icon(Icons.clear, color: AppColors.textMuted, size: 18),
                              onPressed: () {
                                _searchController.clear();
                                setState(() => _searchQuery = '');
                              },
                            )
                          : null,
                      contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                      fillColor: AppColors.surfaceZinc,
                    ),
                  ),
                  const SizedBox(height: 10),
                  // Category Dropdown & Styled Controls Row
                  Row(
                    children: [
                      // Category Filter Dropdown
                      Expanded(
                        child: DropdownButtonFormField<ItemType?>(
                          value: _filterType,
                          dropdownColor: AppColors.surfaceZinc,
                          style: const TextStyle(color: AppColors.offWhite, fontSize: 13, fontWeight: FontWeight.bold),
                          decoration: InputDecoration(
                            isDense: true,
                            contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                            fillColor: AppColors.surfaceZinc,
                            prefixIcon: const Icon(Icons.filter_list_rounded, color: AppColors.orangeAccent, size: 18),
                            border: OutlineInputBorder(
                              borderRadius: BorderRadius.circular(12),
                              borderSide: BorderSide(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                            ),
                          ),
                          items: [
                            const DropdownMenuItem<ItemType?>(
                              value: null,
                              child: Text('All Categories', style: TextStyle(color: AppColors.offWhite, fontSize: 13)),
                            ),
                            ...ItemType.values.map(
                              (t) => DropdownMenuItem<ItemType?>(
                                value: t,
                                child: Text(t.label, style: const TextStyle(color: AppColors.offWhite, fontSize: 13)),
                              ),
                            ),
                          ],
                          onChanged: (val) => setState(() => _filterType = val),
                        ),
                      ),
                      const SizedBox(width: 8),

                      // Sort Direction Button
                      OutlinedButton.icon(
                        onPressed: () => setState(() => _sortDescending = !_sortDescending),
                        icon: Icon(_sortDescending ? Icons.arrow_downward : Icons.arrow_upward, size: 16, color: AppColors.orangeAccent),
                        label: Text(_sortDescending ? 'Newest' : 'Oldest', style: const TextStyle(fontSize: 12, color: AppColors.offWhite)),
                        style: OutlinedButton.styleFrom(
                          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 12),
                          side: BorderSide(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                        ),
                      ),
                      const SizedBox(width: 6),

                      // Grid/List View Toggle Button
                      OutlinedButton.icon(
                        onPressed: () => setState(() => _isGridView = !_isGridView),
                        icon: Icon(_isGridView ? Icons.view_list : Icons.grid_view, size: 16, color: AppColors.orangeAccent),
                        label: Text(_isGridView ? 'List' : 'Grid', style: const TextStyle(fontSize: 12, color: AppColors.offWhite)),
                        style: OutlinedButton.styleFrom(
                          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 12),
                          side: BorderSide(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),

            // Listing Area
            Expanded(
              child: items.isEmpty
                  ? const Center(
                      child: Text('No matching items', style: TextStyle(color: AppColors.textMuted)),
                    )
                  : _isGridView
                      ? GridView.builder(
                          padding: const EdgeInsets.fromLTRB(16, 8, 16, 100),
                          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                            crossAxisCount: 2,
                            crossAxisSpacing: 12,
                            mainAxisSpacing: 12,
                            childAspectRatio: 1.1,
                          ),
                          itemCount: items.length,
                          itemBuilder: (context, index) {
                            final item = items[index];
                            final type = ItemTypeExt.fromString(item.type);
                            final sub = item.fields['username']?.toString() ?? item.fields['cardholder']?.toString() ?? '••••••••';
                            return Card(
                              color: AppColors.surfaceZinc,
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(16),
                                side: BorderSide(color: AppColors.borderZinc.withValues(alpha: 0.5)),
                              ),
                              child: InkWell(
                                onTap: () => _viewItem(key, item),
                                borderRadius: BorderRadius.circular(16),
                                child: Padding(
                                  padding: const EdgeInsets.all(14),
                                  child: Column(
                                    crossAxisAlignment: CrossAxisAlignment.start,
                                    children: [
                                      Row(
                                        children: [
                                          Icon(_getTypeIcon(type), color: AppColors.orangeAccent, size: 20),
                                          const Spacer(),
                                          const Icon(Icons.shield_outlined, size: 14, color: AppColors.textMuted),
                                        ],
                                      ),
                                      const Spacer(),
                                      Text(
                                        item.title,
                                        maxLines: 1,
                                        overflow: TextOverflow.ellipsis,
                                        style: const TextStyle(fontWeight: FontWeight.bold, color: AppColors.offWhite),
                                      ),
                                      const SizedBox(height: 2),
                                      Text(
                                        sub,
                                        maxLines: 1,
                                        overflow: TextOverflow.ellipsis,
                                        style: const TextStyle(fontSize: 11, color: AppColors.textMuted),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            );
                          },
                        )
                      : ListView.builder(
                          padding: const EdgeInsets.fromLTRB(16, 8, 16, 100),
                          itemCount: items.length,
                          itemBuilder: (context, index) {
                            final item = items[index];
                            return _ItemTile(
                              item: item,
                              onTap: () => _viewItem(key, item),
                              onDelete: () => _deleteItem(key, item),
                              index: index,
                            );
                          },
                        ),
            ),
          ],
        );
      },
    );
  }

  // --- TAB 2: PASSWORD GENERATOR (Useful Tool Screen) ---
  Widget _buildGeneratorTab() {
    return const _GeneratorToolTab();
  }



  IconData _getTypeIcon(ItemType type) {
    switch (type) {
      case ItemType.login: return Icons.login_outlined;
      case ItemType.card: return Icons.credit_card_outlined;
      case ItemType.identity: return Icons.badge_outlined;
      case ItemType.note: return Icons.note_outlined;
      case ItemType.developerSecret: return Icons.terminal_outlined;
    }
  }
}

// --- PASSWORD GENERATOR COMPONENT ---
class _GeneratorToolTab extends StatefulWidget {
  const _GeneratorToolTab();

  @override
  State<_GeneratorToolTab> createState() => _GeneratorToolTabState();
}

class _GeneratorToolTabState extends State<_GeneratorToolTab> {
  double _length = 16;
  bool _includeUpper = true;
  bool _includeLower = true;
  bool _includeDigits = true;
  bool _includeSymbols = true;
  String _generatedPassword = '';

  @override
  void initState() {
    super.initState();
    _generatePassword();
  }

  void _generatePassword() {
    const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const lower = 'abcdefghijklmnopqrstuvwxyz';
    const digits = '0123456789';
    const symbols = '!@#\$%^&*()_+-=[]{}|;:,.<>?';

    String pool = '';
    if (_includeUpper) pool += upper;
    if (_includeLower) pool += lower;
    if (_includeDigits) pool += digits;
    if (_includeSymbols) pool += symbols;

    if (pool.isEmpty) pool = lower;

    final rand = Random.secure();
    final pwd = List.generate(_length.round(), (_) => pool[rand.nextInt(pool.length)]).join();
    setState(() => _generatedPassword = pwd);
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.fromLTRB(16, 16, 16, 100),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text('PASSWORD GENERATOR', style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2, color: AppColors.textMuted)),
          const SizedBox(height: 12),
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: AppColors.surfaceZinc,
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.5)),
            ),
            child: Column(
              children: [
                SelectableText(
                  _generatedPassword,
                  style: const TextStyle(fontSize: 18, fontFamily: 'Monospace', fontWeight: FontWeight.bold, color: AppColors.orangeAccent),
                  textAlign: TextAlign.center,
                ),
                const SizedBox(height: 12),
                Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    IconButton.filledTonal(
                      onPressed: () {
                        HapticFeedback.lightImpact();
                        _generatePassword();
                      },
                      icon: const Icon(Icons.refresh, size: 20),
                    ),
                    const SizedBox(width: 12),
                    IconButton.filled(
                      onPressed: () {
                        Clipboard.setData(ClipboardData(text: _generatedPassword));
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('Password copied to clipboard')),
                        );
                      },
                      icon: const Icon(Icons.copy, size: 20),
                    ),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: 20),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              const Text('Password Length', style: TextStyle(color: AppColors.offWhite, fontWeight: FontWeight.w600)),
              Text('${_length.round()}', style: const TextStyle(color: AppColors.orangeAccent, fontWeight: FontWeight.bold)),
            ],
          ),
          Slider(
            value: _length,
            min: 6,
            max: 32,
            activeColor: AppColors.orangeAccent,
            onChanged: (val) {
              setState(() => _length = val);
              _generatePassword();
            },
          ),
          SwitchListTile(
            title: const Text('Uppercase (A-Z)', style: TextStyle(color: AppColors.offWhite, fontSize: 14)),
            value: _includeUpper,
            activeColor: AppColors.orangeAccent,
            onChanged: (val) { setState(() => _includeUpper = val); _generatePassword(); },
          ),
          SwitchListTile(
            title: const Text('Lowercase (a-z)', style: TextStyle(color: AppColors.offWhite, fontSize: 14)),
            value: _includeLower,
            activeColor: AppColors.orangeAccent,
            onChanged: (val) { setState(() => _includeLower = val); _generatePassword(); },
          ),
          SwitchListTile(
            title: const Text('Numbers (0-9)', style: TextStyle(color: AppColors.offWhite, fontSize: 14)),
            value: _includeDigits,
            activeColor: AppColors.orangeAccent,
            onChanged: (val) { setState(() => _includeDigits = val); _generatePassword(); },
          ),
          SwitchListTile(
            title: const Text('Symbols (!@#\$%)', style: TextStyle(color: AppColors.offWhite, fontSize: 14)),
            value: _includeSymbols,
            activeColor: AppColors.orangeAccent,
            onChanged: (val) { setState(() => _includeSymbols = val); _generatePassword(); },
          ),
        ],
      ),
    );
  }
}

// --- FLOATING BOTTOM NAVIGATION BAR ---
class _FloatingBottomNavBar extends StatelessWidget {
  final int currentIndex;
  final ValueChanged<int> onTap;

  const _FloatingBottomNavBar({
    required this.currentIndex,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<bool>(
      valueListenable: UpdateService.hasUpdateAvailable,
      builder: (context, hasUpdate, _) {
        final activeAccent = Theme.of(context).colorScheme.primary;

        return Container(
          height: 64,
          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 6),
          decoration: BoxDecoration(
            color: const Color(0xFF141417),
            borderRadius: BorderRadius.circular(32),
            border: Border.all(color: AppColors.borderZinc, width: 1.2),
            boxShadow: const [
              BoxShadow(
                color: Colors.black87,
                blurRadius: 24,
                offset: Offset(0, 8),
              ),
            ],
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            children: [
              _NavBarItem(icon: Icons.home_outlined, activeIcon: Icons.home_rounded, label: 'Home', isSelected: currentIndex == 0, onTap: () => onTap(0)),
              _NavBarItem(icon: Icons.lock_outline_rounded, activeIcon: Icons.lock_rounded, label: 'Vault', isSelected: currentIndex == 1, onTap: () => onTap(1)),
              _NavBarItem(icon: Icons.casino_outlined, activeIcon: Icons.casino_rounded, label: 'Generate', isSelected: currentIndex == 2, onTap: () => onTap(2)),
              _NavBarItem(icon: Icons.wifi_tethering_rounded, activeIcon: Icons.wifi_tethering_rounded, label: 'Share', isSelected: currentIndex == 3, onTap: () => onTap(3)),
              _NavBarItem(icon: Icons.settings_outlined, activeIcon: Icons.settings_rounded, label: 'Settings', isSelected: currentIndex == 4, hasBadge: hasUpdate, onTap: () => onTap(4)),
            ],
          ),
        );
      },
    );
  }
}

class _NavBarItem extends StatelessWidget {
  final IconData icon;
  final IconData activeIcon;
  final String label;
  final bool isSelected;
  final bool hasBadge;
  final VoidCallback onTap;

  const _NavBarItem({
    required this.icon,
    required this.activeIcon,
    required this.label,
    required this.isSelected,
    this.hasBadge = false,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    final activeAccent = Theme.of(context).colorScheme.primary;

    return Expanded(
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: onTap,
          borderRadius: BorderRadius.circular(24),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 220),
            curve: Curves.easeOutCubic,
            padding: const EdgeInsets.symmetric(vertical: 4),
            decoration: isSelected
                ? BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: [
                        activeAccent.withValues(alpha: 0.28),
                        activeAccent.withValues(alpha: 0.12),
                      ],
                    ),
                    borderRadius: BorderRadius.circular(22),
                    border: Border.all(
                      color: activeAccent.withValues(alpha: 0.45),
                      width: 1,
                    ),
                    boxShadow: const [
                      BoxShadow(
                        color: Colors.black26,
                        offset: Offset(0, 2),
                        blurRadius: 4,
                      ),
                    ],
                  )
                : const BoxDecoration(),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              mainAxisSize: MainAxisSize.min,
              children: [
                Stack(
                  clipBehavior: Clip.none,
                  children: [
                    AnimatedScale(
                      scale: isSelected ? 1.1 : 1.0,
                      duration: const Duration(milliseconds: 200),
                      curve: Curves.easeOutCubic,
                      child: Icon(
                        isSelected ? activeIcon : icon,
                        color: isSelected ? AppColors.orangeAccent : AppColors.textMuted,
                        size: 20,
                      ),
                    ),
                    if (hasBadge)
                      Positioned(
                        right: -3,
                        top: -3,
                        child: Container(
                          width: 8,
                          height: 8,
                          decoration: const BoxDecoration(
                            color: Colors.redAccent,
                            shape: BoxShape.circle,
                          ),
                        ),
                      ),
                  ],
                ),
                const SizedBox(height: 2),
                AnimatedDefaultTextStyle(
                  duration: const Duration(milliseconds: 200),
                  style: TextStyle(
                    fontSize: 10,
                    fontWeight: isSelected ? FontWeight.w700 : FontWeight.normal,
                    color: isSelected ? AppColors.orangeAccent : AppColors.textMuted,
                    letterSpacing: -0.1,
                  ),
                  child: Text(label),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _CategorySummaryCard extends StatelessWidget {
  final String title;
  final int count;
  final IconData icon;
  final Color accentColor;
  final bool isSelected;
  final VoidCallback onTap;

  const _CategorySummaryCard({
    required this.title,
    required this.count,
    required this.icon,
    this.accentColor = AppColors.orangeAccent,
    this.isSelected = false,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 106,
      margin: const EdgeInsets.only(right: 10),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(16),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 200),
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: isSelected ? accentColor.withValues(alpha: 0.15) : AppColors.surfaceZinc,
            borderRadius: BorderRadius.circular(16),
            border: Border.all(
              color: isSelected ? accentColor : AppColors.borderZinc.withValues(alpha: 0.5),
              width: isSelected ? 1.5 : 1.0,
            ),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Container(
                    padding: const EdgeInsets.all(7),
                    decoration: BoxDecoration(
                      color: accentColor.withValues(alpha: 0.15),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Icon(icon, size: 18, color: accentColor),
                  ),
                  Text(
                    '$count',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                      color: isSelected ? accentColor : AppColors.offWhite,
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),
              Text(
                title,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                style: TextStyle(
                  fontSize: 12,
                  fontWeight: FontWeight.w600,
                  color: isSelected ? accentColor : AppColors.offWhite,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _ItemTile extends StatelessWidget {
  final DecryptedItem item;
  final VoidCallback onTap;
  final VoidCallback onDelete;
  final int index;

  const _ItemTile({
    required this.item,
    required this.onTap,
    required this.onDelete,
    required this.index,
  });

  @override
  Widget build(BuildContext context) {
    final type = ItemTypeExt.fromString(item.type);
    final subtitle = item.fields['username']?.toString() ??
        item.fields['cardholder']?.toString() ??
        '••••••••••••';

    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      decoration: BoxDecoration(
        color: AppColors.surfaceZinc,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.4)),
      ),
      child: ListTile(
        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
        leading: Container(
          padding: const EdgeInsets.all(10),
          decoration: BoxDecoration(
            color: AppColors.orangeContainer,
            borderRadius: BorderRadius.circular(12),
          ),
          child: Icon(_getTypeIcon(type), color: AppColors.orangeAccent, size: 20),
        ),
        title: Text(item.title, style: const TextStyle(fontWeight: FontWeight.bold, color: AppColors.offWhite)),
        subtitle: Text(subtitle, style: const TextStyle(fontSize: 12, color: AppColors.textMuted)),
        trailing: const Icon(Icons.chevron_right, color: AppColors.textMuted, size: 20),
        onTap: onTap,
      ),
    );
  }

  IconData _getTypeIcon(ItemType type) {
    switch (type) {
      case ItemType.login: return Icons.login_outlined;
      case ItemType.card: return Icons.credit_card_outlined;
      case ItemType.identity: return Icons.badge_outlined;
      case ItemType.note: return Icons.note_outlined;
      case ItemType.developerSecret: return Icons.terminal_outlined;
    }
  }
}

// --- P2P SHARING TAB CONTAINER ---
class _P2PSharingTab extends StatefulWidget {
  const _P2PSharingTab();

  @override
  State<_P2PSharingTab> createState() => _P2PSharingTabState();
}

class _P2PSharingTabState extends State<_P2PSharingTab>
    with SingleTickerProviderStateMixin {
  late TabController _tabController;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 2, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Container(
          margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
          decoration: BoxDecoration(
            color: AppColors.surfaceZinc,
            borderRadius: BorderRadius.circular(12),
            border: Border.all(color: AppColors.borderZinc.withValues(alpha: 0.4)),
          ),
          child: TabBar(
            controller: _tabController,
            indicatorColor: AppColors.orangeAccent,
            labelColor: AppColors.orangeAccent,
            unselectedLabelColor: AppColors.textMuted,
            tabs: const [
              Tab(icon: Icon(Icons.upload_outlined, size: 18), text: 'Send'),
              Tab(icon: Icon(Icons.download_outlined, size: 18), text: 'Receive'),
            ],
          ),
        ),
        Expanded(
          child: TabBarView(
            controller: _tabController,
            children: const [
              P2PShareScreen(),
              P2PReceiveScreen(),
            ],
          ),
        ),
      ],
    );
  }
}

